# syntax=docker/dockerfile:1.7

ARG RUST_VERSION=1.85
FROM docker.io/library/rust:${RUST_VERSION}-bookworm AS rust-builder

WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
RUN cargo build --release --locked --bin andromeda --bin andromeda-taskd

FROM quay.io/fedora/fedora-bootc:44 AS payload

ARG PLATFORM_VARIANT=pc_x86_64
ARG PLATFORM_ARCHITECTURE=x86_64
ARG BOOT_PROVIDER=pc_uefi_shim
ARG HEP_ID=pc-mainline

LABEL io.andromeda.platform.variant="${PLATFORM_VARIANT}" \
      io.andromeda.platform.architecture="${PLATFORM_ARCHITECTURE}" \
      io.andromeda.platform.boot-provider="${BOOT_PROVIDER}" \
      io.andromeda.platform.hep-id="${HEP_ID}"

# Platform base: control-plane dependencies, guest agents, networking
# and WWAN, storage tooling, sensors/input, device firmware, and
# reliability defaults (zram + systemd-oomd).
RUN dnf -y install \
        ModemManager \
        NetworkManager \
        NetworkManager-bluetooth \
        NetworkManager-config-connectivity-fedora \
        NetworkManager-ppp \
        NetworkManager-wifi \
        NetworkManager-wwan \
        amd-gpu-firmware \
        amd-ucode-firmware \
        atheros-firmware \
        b43-fwcutter \
        b43-openfwwf \
        brcmfmac-firmware \
        btrfs-progs \
        cirrus-audio-firmware \
        curl \
        dosfstools \
        e2fsprogs \
        exfatprogs \
        f2fs-tools \
        firewalld \
        iio-sensor-proxy \
        intel-audio-firmware \
        intel-gpu-firmware \
        intel-vsc-firmware \
        iw \
        iwlegacy-firmware \
        iwlwifi-dvm-firmware \
        iwlwifi-mvm-firmware \
        jq \
        kde-partitionmanager \
        kernel-modules-extra \
        libinput-utils \
        libva-intel-media-driver \
        libva-utils \
        libwacom \
        linux-firmware \
        lvm2 \
        mdadm \
        mesa-dri-drivers \
        mesa-vulkan-drivers \
        mobile-broadband-provider-info \
        mt7xxx-firmware \
        ntfs-3g \
        nvidia-gpu-firmware \
        nvme-cli \
        nxpwireless-firmware \
        openssh-server \
        pciutils \
        podman \
        qcom-wwan-firmware \
        qemu-guest-agent \
        realtek-firmware \
        skopeo \
        smartmontools \
        sudo \
        switcheroo-control \
        systemd-oomd-defaults \
        tpm2-tools \
        udisks2 \
        udisks2-lvm2 \
        usb_modeswitch \
        usbutils \
        vulkan-loader \
        vulkan-tools \
        wireless-regdb \
        wpa_supplicant \
        xfsprogs \
        zram-generator-defaults \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Desktop session and peripherals: Plasma/KWin/SDDM, portals, Flatpak,
# PipeWire audio, Bluetooth, printing/scanning, camera, Thunderbolt,
# fingerprint, firmware updates, and power management.
RUN dnf -y install \
        alsa-firmware \
        alsa-sof-firmware \
        alsa-tools-firmware \
        alsa-ucm \
        alsa-utils \
        ark \
        avahi \
        bluedevil \
        bluez \
        bluez-obexd \
        bolt \
        cups \
        cups-browsed \
        cups-filters \
        cups-pk-helper \
        dolphin \
        fedora-flathub-remote \
        ffmpegthumbs \
        firewall-config \
        flatpak \
        fprintd \
        fwupd \
        gwenview \
        ipp-usb \
        kate \
        kcalc \
        kdegraphics-thumbnailers \
        kinfocenter \
        kio-extras \
        konsole \
        kwin \
        lcms2 \
        libcamera-gstreamer \
        libcamera-tools \
        libssh \
        nss-mdns \
        okular \
        pipewire \
        pipewire-alsa \
        pipewire-gstreamer \
        pipewire-plugin-libcamera \
        pipewire-pulseaudio \
        pipewire-utils \
        pipewire-v4l2 \
        plasma-desktop \
        plasma-discover \
        plasma-discover-flatpak \
        plasma-nm \
        plasma-pa \
        plasma-print-manager \
        plasma-systemmonitor \
        plasma-thunderbolt \
        plasma-workspace \
        powerdevil \
        qt6-qtwayland \
        sane-airscan \
        sane-backends \
        sane-backends-drivers-scanners \
        sddm \
        simple-scan \
        spectacle \
        system-config-printer \
        system-config-printer-udev \
        thermald \
        upower \
        v4l-utils \
        wireplumber \
        xdg-desktop-portal \
        xdg-desktop-portal-gtk \
        xdg-desktop-portal-kde \
        xorg-x11-server-Xwayland \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# End-user applications and i18n: LibreOffice, Firefox, media codecs,
# archives, Chinese input and fonts, locales, and the 32-bit gaming
# runtime baseline.
RUN dnf -y install \
        7zip \
        alsa-lib.i686 \
        fcitx5 \
        fcitx5-autostart \
        fcitx5-chinese-addons \
        fcitx5-gtk \
        fcitx5-qt \
        ffmpeg-free \
        firefox \
        gamemode \
        gamescope \
        glibc-langpack-en \
        glibc-langpack-zh \
        google-noto-color-emoji-fonts \
        gstreamer1-plugins-bad-free \
        gstreamer1-plugins-base \
        gstreamer1-plugins-good \
        gstreamer1-plugins-ugly-free \
        hunspell \
        hunspell-en \
        liberation-fonts-all \
        libreoffice-calc \
        libreoffice-draw \
        libreoffice-impress \
        libreoffice-writer \
        mangohud \
        mesa-dri-drivers.i686 \
        mesa-vulkan-drivers.i686 \
        pipewire-libs.i686 \
        poppler-utils \
        steam-devices \
        unar \
        unzip \
        vulkan-loader.i686 \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY --from=rust-builder /src/target/release/andromeda /usr/bin/andromeda
COPY --from=rust-builder /src/target/release/andromeda-taskd /usr/bin/andromeda-taskd
COPY os/files/ /

ARG IMAGE_REVISION=1

RUN mkdir -p /usr/lib/andromeda \
    && printf '%s\n' "${IMAGE_REVISION}" > /usr/lib/andromeda/image-revision \
    && jq --null-input \
        --arg variant "${PLATFORM_VARIANT}" \
        --arg architecture "${PLATFORM_ARCHITECTURE}" \
        --arg boot_provider "${BOOT_PROVIDER}" \
        --arg hep_id "${HEP_ID}" \
        --arg image_revision "${IMAGE_REVISION}" \
        '{schema_version:1,variant:$variant,architecture:$architecture,boot_provider:$boot_provider,hep_id:$hep_id,image_revision:$image_revision}' \
        > /usr/lib/andromeda/platform.json \
    && systemctl disable sshd.service sshd.socket \
    && systemctl enable \
        NetworkManager.service \
        andromeda-first-boot-labels.service \
        andromeda-hardware-report.service \
        andromeda-taskd.service \
        andromeda-ci-verify.service \
        bluetooth.service \
        cups.service \
        avahi-daemon.service \
        avahi-daemon.socket \
        firewalld.service \
        fstrim.timer \
        fwupd-refresh.timer \
        qemu-guest-agent.service \
        sddm.service \
        systemd-oomd.service \
    && systemctl set-default graphical.target \
    && bootc container lint

FROM payload AS installer

ARG INSTALLER_DEFAULT=0

RUN dnf -y install \
        anaconda \
        anaconda-dracut \
        anaconda-install-img-deps \
        default-fonts-core-sans \
        default-fonts-other-sans \
        dracut-config-generic \
        dracut-network \
        efibootmgr \
        google-noto-sans-cjk-fonts \
        grub2-efi-x64 \
        grub2-efi-x64-cdboot \
        net-tools \
        plymouth \
        shim-x64 \
        squashfs-tools \
        xorrisofs \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && mkdir -p /boot/efi \
    && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

COPY os/installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY os/installer/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks
COPY os/installer/andromeda-ci.ks /usr/share/anaconda/andromeda-ci.ks
COPY os/installer/install-uefi-fallback.sh /usr/libexec/andromeda-install-uefi-fallback
COPY os/installer/installer-preflight.sh /usr/libexec/andromeda-installer-preflight
COPY os/installer/check-platform-compatibility.sh /usr/libexec/andromeda-check-platform-compatibility
COPY os/installer/collect-anaconda-diagnostics.sh /usr/libexec/andromeda-collect-anaconda-diagnostics

RUN case "${INSTALLER_DEFAULT}" in \
        0|1) ;; \
        *) printf 'INSTALLER_DEFAULT must be 0 or 1, got: %s\n' \
            "${INSTALLER_DEFAULT}" >&2; exit 1 ;; \
    esac \
    && sed -i "s/^  default: 0$/  default: ${INSTALLER_DEFAULT}/" \
        /usr/lib/image-builder/bootc/iso.yaml \
    && grep -q "^  default: ${INSTALLER_DEFAULT}$" \
        /usr/lib/image-builder/bootc/iso.yaml \
    && anaconda_version="$(rpm -q --qf '%{VERSION}\n' anaconda-core)" \
    && test "${anaconda_version%%.*}" -ge 44 \
    && printf 'Validated Anaconda %s with native bootc payload support.\n' \
        "${anaconda_version}" \
    && bootc --version \
    && test -f /boot/efi/EFI/fedora/shimx64.efi \
    && test -f /boot/efi/EFI/fedora/grubx64.efi \
    && test -f /boot/efi/EFI/fedora/mmx64.efi \
    && test -f /boot/efi/EFI/fedora/gcdx64.efi \
    && printf '%s\n' \
        'install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda' \
        >> /etc/passwd \
    && printf '%s\n' 'install::14438:0:99999:7:::' >> /etc/shadow \
    && passwd -d root \
    && mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
    && mv /etc/yum.repos.d /etc/anaconda.repos.d \
    && rm -f /etc/systemd/system/default.target \
    && ln -s /usr/lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
    && rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator \
    && rm -f /usr/lib/systemd/system/autovt@.service \
    && ln -s /usr/lib/systemd/system/anaconda-shell@.service \
        /usr/lib/systemd/system/autovt@.service \
    && mkdir -p /usr/lib/systemd/logind.conf.d \
    && printf '%s\n' '[Login]' 'ReserveVT=2' \
        > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf \
    && mkdir -p "$(realpath /root)" \
    && kernel="$(kernel-install list --json pretty \
        | jq -r '.[] | select(.has_kernel == true) | .version')" \
    && DRACUT_NO_XATTR=1 dracut --force --verbose --zstd --reproducible \
        --no-hostonly \
        --add anaconda \
        --include /usr/share/anaconda/andromeda-ci.ks /andromeda-ci.ks \
        --include /usr/share/anaconda/interactive-defaults.ks /interactive-defaults.ks \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}" \
    && mkdir -p /etc/systemd/user/pipewire.service.d \
        /etc/systemd/user/pipewire.socket.d \
    && printf '%s\n' '[Unit]' 'ConditionUser=' \
        > /etc/systemd/user/pipewire.service.d/allowroot.conf \
    && printf '%s\n' '[Unit]' 'ConditionUser=' \
        > /etc/systemd/user/pipewire.socket.d/allowroot.conf
