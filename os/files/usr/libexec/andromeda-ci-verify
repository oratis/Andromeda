#!/usr/bin/bash
set -Eeuo pipefail

readonly STATE_DIR=/var/lib/andromeda-ci
readonly STATE_FILE="${STATE_DIR}/state"
readonly UPDATE_ARCHIVE=/var/tmp/andromeda-v2.tar
readonly UPDATE_SHA256_FW_CFG=/sys/firmware/qemu_fw_cfg/by_name/opt/andromeda/update-sha256/raw
readonly UPDATE_PORT_FW_CFG=/sys/firmware/qemu_fw_cfg/by_name/opt/andromeda/update-port/raw
readonly UPDATE_PORT_FALLBACK=8080

# The host binds the update server on a kernel-assigned port (see
# test-install.sh) and passes it through fw_cfg. Unlike the SHA-256 -- which is
# a trust anchor and therefore a hard requirement -- the port is only routing:
# fall back to the historical 8080 when the entry is absent, so an image built
# from this tree still works with an older harness. Getting the port wrong
# cannot weaken anything; it just fails the download, and the archive is
# SHA-verified regardless of which port delivered it.
resolve_update_url() {
    local port="${UPDATE_PORT_FALLBACK}"
    modprobe qemu_fw_cfg 2>/dev/null || true
    if [[ -r "${UPDATE_PORT_FW_CFG}" ]]; then
        local advertised
        advertised="$(tr -cd '0-9' < "${UPDATE_PORT_FW_CFG}")"
        if [[ -n "${advertised}" ]] && ((advertised > 0 && advertised < 65536)); then
            port="${advertised}"
        else
            emit "ANDROMEDA_UPDATE_PORT_INVALID advertised=${advertised:-empty} falling-back=${UPDATE_PORT_FALLBACK}"
        fi
    fi
    printf 'http://10.0.2.2:%s/andromeda-v2.tar' "${port}"
}

emit() {
    local message="$1"
    if [[ -c /dev/ttyS0 && -w /dev/ttyS0 ]]; then
        printf '%s\n' "${message}" | tee /dev/ttyS0
    else
        printf '%s\n' "${message}"
    fi
    systemd-cat -t andromeda-ci printf '%s\n' "${message}"
}

require_runtime_health() {
    test -d /sys/firmware/efi
    test -s /var/lib/andromeda/hardware.json
    test -s /var/lib/andromeda/hardware-diagnosis.json
    jq --exit-status \
        '.schema_version == 1 and .boot_critical_missing == 0 and .readiness != "blocked"' \
        /var/lib/andromeda/hardware-diagnosis.json >/dev/null
    test "$(getenforce)" = Enforcing
    systemctl is-active --quiet andromeda-taskd.service
    systemctl is-active --quiet sddm.service
    curl --fail --silent --show-error --retry 30 --retry-delay 2 \
        --retry-connrefused \
        http://127.0.0.1:7777/healthz >/dev/null
}

# The lifecycle payload arrives over plain HTTP from the QEMU host. The host
# test harness passes the expected SHA-256 through fw_cfg; refuse to import
# anything that does not match. This is CI-only wiring (the unit is gated on
# andromeda.ci=1), so a missing fw_cfg entry is a hard failure, not a fallback.
verify_update_archive() {
    local expected_sha256 actual_sha256
    modprobe qemu_fw_cfg 2>/dev/null || true
    test -r "${UPDATE_SHA256_FW_CFG}"
    expected_sha256="$(
        tr -cd 'A-Fa-f0-9' < "${UPDATE_SHA256_FW_CFG}" \
            | tr '[:upper:]' '[:lower:]'
    )"
    test "${#expected_sha256}" -eq 64
    actual_sha256="$(sha256sum "${UPDATE_ARCHIVE}" | cut -d' ' -f1)"
    if [[ "${actual_sha256}" != "${expected_sha256}" ]]; then
        emit "ANDROMEDA_UPDATE_VERIFY_FAILED expected=${expected_sha256} actual=${actual_sha256}"
        return 1
    fi
    emit "ANDROMEDA_UPDATE_VERIFY_OK sha256=${actual_sha256}"
}

install -d -m 0700 "${STATE_DIR}"
revision="$(tr -d '[:space:]' < /usr/lib/andromeda/image-revision)"
state="first-boot"
if [[ -f "${STATE_FILE}" ]]; then
    state="$(tr -d '[:space:]' < "${STATE_FILE}")"
fi

on_error() {
    local status="$1"
    local line="$2"
    trap - ERR
    set +e
    emit \
        "ANDROMEDA_E2E_FAILED state=${state} revision=${revision} line=${line} status=${status}"
    exit "${status}"
}
trap 'on_error "$?" "${LINENO}"' ERR

require_runtime_health
/usr/libexec/andromeda-daily-driver-verify "${state}" "${revision}"

case "${state}:${revision}" in
    first-boot:1)
        emit "ANDROMEDA_FIRST_BOOT_OK revision=1"
        update_url="$(resolve_update_url)"
        emit "ANDROMEDA_UPDATE_FETCH_START url=${update_url}"
        curl --fail --location --show-error --retry 60 --retry-delay 2 \
            --retry-connrefused \
            --output "${UPDATE_ARCHIVE}" "${update_url}"
        verify_update_archive
        skopeo copy --retry-times 5 \
            "oci-archive:${UPDATE_ARCHIVE}" \
            containers-storage:localhost/andromeda:v2
        rm -f "${UPDATE_ARCHIVE}"
        bootc switch --transport containers-storage localhost/andromeda:v2
        printf '%s\n' updating > "${STATE_FILE}"
        emit "ANDROMEDA_UPDATE_STAGED_OK revision=2"
        systemctl reboot
        ;;
    updating:2)
        emit "ANDROMEDA_UPDATE_BOOT_OK revision=2"
        bootc rollback
        printf '%s\n' rolling-back > "${STATE_FILE}"
        emit "ANDROMEDA_ROLLBACK_STAGED_OK revision=1"
        systemctl reboot
        ;;
    rolling-back:1)
        emit "ANDROMEDA_ROLLBACK_BOOT_OK revision=1"
        printf '%s\n' complete > "${STATE_FILE}"
        emit "ANDROMEDA_E2E_OK"
        ;;
    complete:1)
        emit "ANDROMEDA_E2E_OK"
        ;;
    *)
        emit "ANDROMEDA_E2E_FAILED state=${state} revision=${revision}"
        exit 1
        ;;
esac
