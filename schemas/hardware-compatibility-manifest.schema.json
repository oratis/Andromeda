{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oratis/Andromeda/schemas/hardware-compatibility-manifest.schema.json",
  "title": "Andromeda Hardware Compatibility Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "tier",
    "boot_provider",
    "selectors",
    "requirements",
    "kernel_channels",
    "artifacts",
    "evidence",
    "expires_at",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "blocked",
        "community",
        "supported",
        "certified",
        "reference"
      ]
    },
    "boot_provider": {
      "enum": [
        "pc_uefi_shim",
        "intel_mac_efi",
        "t2_experimental",
        "apple_silicon_asahi",
        "other"
      ]
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/selector"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/memory"
          },
          {
            "$ref": "#/$defs/boot"
          },
          {
            "$ref": "#/$defs/device"
          }
        ]
      }
    },
    "kernel_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_family",
        "architectures",
        "manufacturer_contains",
        "model_prefix"
      ],
      "properties": {
        "os_family": {
          "enum": [
            "linux",
            "macos",
            "windows",
            "other",
            null
          ]
        },
        "architectures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manufacturer_contains": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_prefix": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minimum"
      ],
      "properties": {
        "type": {
          "const": "memory_bytes"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "uefi",
        "secure_boot",
        "tpm2",
        "virtualization"
      ],
      "properties": {
        "type": {
          "const": "boot"
        },
        "uefi": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "secure_boot": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tpm2": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "virtualization": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bus",
        "vendor_id",
        "product_id",
        "subsystem_vendor_id",
        "subsystem_product_id",
        "revision",
        "driver_required"
      ],
      "properties": {
        "type": {
          "const": "device"
        },
        "bus": {
          "type": "string",
          "minLength": 1
        },
        "vendor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subsystem_vendor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subsystem_product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver_required": {
          "type": "boolean"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version",
        "sha256",
        "source",
        "signing_key_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "kernel",
            "driver",
            "firmware",
            "hardware_enablement_image"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "signing_key_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "result",
        "evidence_uri",
        "collected_at",
        "expires_at"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "evidence_uri": {
          "type": "string",
          "minLength": 1
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
