{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oratis/Andromeda/schemas/hardware-compatibility-manifest.schema.json",
  "title": "Andromeda Hardware Compatibility Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "tier",
    "selectors",
    "requirements",
    "kernel_channels",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "blocked",
        "community",
        "supported",
        "certified",
        "reference"
      ]
    },
    "selectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/selector"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/memory"
          },
          {
            "$ref": "#/$defs/boot"
          },
          {
            "$ref": "#/$defs/device"
          }
        ]
      }
    },
    "kernel_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_family",
        "architectures",
        "manufacturer_contains",
        "model_prefix"
      ],
      "properties": {
        "os_family": {
          "enum": [
            "linux",
            "macos",
            "windows",
            "other",
            null
          ]
        },
        "architectures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manufacturer_contains": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_prefix": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minimum"
      ],
      "properties": {
        "type": {
          "const": "memory_bytes"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "uefi",
        "secure_boot",
        "tpm2",
        "virtualization"
      ],
      "properties": {
        "type": {
          "const": "boot"
        },
        "uefi": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "secure_boot": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tpm2": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "virtualization": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bus",
        "vendor_id",
        "product_id",
        "driver_required"
      ],
      "properties": {
        "type": {
          "const": "device"
        },
        "bus": {
          "type": "string",
          "minLength": 1
        },
        "vendor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver_required": {
          "type": "boolean"
        }
      }
    }
  }
}
